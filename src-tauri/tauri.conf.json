{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "emission_calculation",
  "version": "0.1.0",
  "identifier": "com.emission.calculation",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://localhost:3000/Electromagnetic_radiation_front",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Калькулятор электромагнитного излучения",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
    "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: http: https: ws: wss:; connect-src 'self' http: https: ws: wss:; img-src 'self' data: blob: http: https: *;",
    "dangerousDisableAssetCspModification": false
  }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
